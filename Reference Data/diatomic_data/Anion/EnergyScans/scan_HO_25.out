--------------------------------------------------------------------------
memory 8 Gb

molecule { 
-1 1
O           0.000000           0.000000           0.000000
H           0.000000           0.000000           1.099876
}

set { 
basis              cc-pvtz
reference          uks
maxiter            500
DAMPING_PERCENTAGE 1
E_CONVERGENCE      1.0E-8
D_CONVERGENCE      1.0E-8
DIIS_MAX_VECS      400
MBIS_MAXITER       8000
}

E, wfn = energy('b3lyp', return_wfn=True)
properties('b3lyp','MBIS_CHARGES', wfn=wfn)
wfn.to_file('last_wfn')

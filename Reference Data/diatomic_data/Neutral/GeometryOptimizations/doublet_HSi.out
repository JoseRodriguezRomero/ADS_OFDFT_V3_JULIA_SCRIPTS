molecule { 
0 2
H   0.00000        0.60000        0.00000
Si   0.00000       -0.60000        0.00000
}

set { 
basis              cc-pvdz
reference          uks
maxiter            500
geom_maxiter       500
DAMPING_PERCENTAGE 1
guess              SAP
}

optimize('b3lyp')

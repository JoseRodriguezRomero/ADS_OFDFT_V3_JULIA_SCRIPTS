molecule S {
0 3 
S 0.0 0.0 0.0 
}

set reference uks
set basis aug-cc-pvtz
set cubeprop_tasks ['orbitals']
set cubic_grid_spacing [0.0, 0.0, 0.01] 
set cubic_grid_overage [0, 0, 20] 
set cubeprop_orbitals [1,2,3,4,5,6,7,8,9,-1,-2,-3,-4,-5,-6,-7]

E, wfn = energy('b3lyp', return_wfn=True)
cubeprop(wfn)

